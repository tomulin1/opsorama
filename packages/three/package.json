{
  "name": "@opsorama/three",
  "version": "0.0.1",
  "description": "Opsorama Three.js scene renderer: camera, selection, labels, motion playback, instancing and resource disposal. Ships no models; pass an asset registry such as catalogAssets from @opsorama/objects.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
