    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@opsorama/core": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.180.0"
  },
  "author": {
    "name": "Tomas Jirsa",
    "email": "contact@opsorama.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomulin1/opsorama.git",
    "directory": "packages/three"
  }
}
