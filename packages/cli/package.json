{
  "name": "@opsorama/cli",
  "version": "0.0.1",
  "description": "Opsorama command line: check scene files without a browser, render scenes to PNG in headless Chromium, search the object catalog, read the documentation and install the agent skill, so people and AI coding agents can build and verify scenes from a terminal.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "opsorama": "./bin/opsorama.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opsorama/core": "workspace:*",
    "@opsorama/objects": "workspace:*",
    "@opsorama/three": "workspace:*",
    "esbuild": "0.28.2",
    "three": "^0.187.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright-core": "1.65.1"
  },
  "author": {
    "name": "Tomas Jirsa",
    "email": "contact@opsorama.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomulin1/opsorama.git",
    "directory": "packages/cli"
  }
}
