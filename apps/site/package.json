{
  "name": "@opsorama/site",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Opsorama documentation website, domain examples and object browser. Never published.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "colors:generate": "node scripts/brand-colors.mjs --write",
    "check:colors": "node scripts/brand-colors.mjs",
    "test:e2e": "next build && playwright test",
    "test:e2e:measure": "next build && playwright test --config playwright.measure.config.ts"
  },
  "dependencies": {
    "@opsorama/core": "workspace:*",
    "@opsorama/objects": "workspace:*",
    "@opsorama/react": "workspace:*",
    "@opsorama/three": "workspace:*",
    "@opsorama/ui": "workspace:*",
    "@opsorama/vue": "workspace:*",
    "lucide-react": "^0.545.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5",
    "ios_saf >= 17.5"
  ],
  "author": {
    "name": "Tomas Jirsa",
    "email": "contact@opsorama.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomulin1/opsorama.git",
    "directory": "apps/site"
  }
}
