{
  "name": "opsorama-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Workspace root of the Opsorama toolkit: packages in packages/*, the website in apps/site, workspace-wide unit tests in tests/.",
  "scripts": {
    "dev": "pnpm --filter @opsorama/site dev",
    "build:packages": "node scripts/build-packages.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "smoke:starters": "node scripts/smoke-starters.mjs",
    "build": "pnpm --filter @opsorama/site build",
    "build:static": "pnpm --filter @opsorama/site build:static",
    "start": "pnpm --filter @opsorama/site start",
    "colors:generate": "pnpm --filter @opsorama/site colors:generate",
    "check:colors": "pnpm --filter @opsorama/site check:colors",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:boundary": "node scripts/check-public-boundary.mjs --all",
    "measure:bundles": "node scripts/measure-kit-bundles.mjs",
    "check:bundles": "node scripts/measure-kit-bundles.mjs --check",
    "test": "pnpm check:colors && pnpm check:boundary && vitest run",
    "test:e2e": "pnpm --filter @opsorama/site test:e2e",
    "test:e2e:measure": "pnpm --filter @opsorama/site test:e2e:measure",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.4",
    "@eslint/eslintrc": "^3.3.1",
    "@opsorama/core": "workspace:*",
    "@opsorama/objects": "workspace:*",
    "@opsorama/react": "workspace:*",
    "@opsorama/three": "workspace:*",
    "@opsorama/ui": "workspace:*",
    "@opsorama/vue": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.187.0",
    "esbuild": "0.28.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "publint": "0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsup": "8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.45"
  },
  "author": {
    "name": "Tomas Jirsa",
    "email": "contact@opsorama.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomulin1/opsorama.git"
  }
}
