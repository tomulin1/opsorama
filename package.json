{
  "name": "opsorama-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "colors:generate": "node scripts/brand-colors.mjs --write",
    "check:colors": "node scripts/brand-colors.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm check:colors && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opsorama/core": "workspace:*",
    "@opsorama/react": "workspace:*",
    "@opsorama/renderer-three": "workspace:*",
    "@opsorama/vue": "workspace:*",
    "@opsorama/ui": "workspace:*",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "author": {
    "name": "Tomas Jirsa",
    "email": "contact@opsorama.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomulin1/opsorama.git"
  }
}
